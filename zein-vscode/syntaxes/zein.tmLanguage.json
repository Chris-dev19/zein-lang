{
  "scopeName": "source.zn",
  "name": "Zein",
  "fileTypes": ["zn"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [{
        "name": "comment.line.double-slash.zn",
        "match": "//.*$"
      }]
    },
    "keywords": {
      "patterns": [{
        "name": "keyword.control.zn",
        "match": "\\b(module|import|as|fn|let|type|if|else|match|for|in|return|true|false)\\b"
      }]
    },
    "types": {
      "patterns": [{
        "name": "storage.type.zn",
        "match": "\\b(Int|Float|String|Bool|Void|Option)\\b"
      }]
    },
    "strings": {
      "name": "string.quoted.double.zn",
      "begin": "\"",
      "end": "\"",
      "patterns": [{
        "name": "constant.character.escape.zn",
        "match": "\\\\[nt\"\\\\]"
      }]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.zn", "match": "\\b\\d+\\.\\d+\\b" },
        { "name": "constant.numeric.integer.zn", "match": "\\b\\d+\\b" }
      ]
    },
    "operators": {
      "name": "keyword.operator.zn",
      "match": "(?:\\+|\\-|\\*|/|%|==|!=|<|>|<=|>=|&&|\\|\\||!|<>|\\|>|->|\\.\\.|=|:)"
    },
    "identifiers": {
      "name": "variable.other.zn",
      "match": "[a-zA-Z_][a-zA-Z0-9_]*"
    }
  }
}
